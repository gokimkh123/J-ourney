# 기획 문서 원본(PDF)은 저장소에 포함하지 않음
*.pdf

# 포스터 등 발표 자료 원본(PPTX)은 저장소에 포함하지 않음
*.pptx

# 비밀값 파일(API 키 등)은 저장소에 포함하지 않음 (.env.example만 허용)
.env
.env.*
!.env.example

# Node 의존성과 빌드 산출물은 저장소에 포함하지 않음
node_modules/
dist/
coverage/

# 로컬 전용 문서 폴더 (동작 흐름·명세서 원본 등은 저장소에 포함하지 않음)
docs/

# 수집한 관광 데이터(DB 덤프·원본 응답 파일)는 저장소에 포함하지 않음 (데이터는 DB에만 둠)
server/data/
*.dump
*.pgdump
*.sql.gz

# 인증서·서명 키·계정 자격 증명 파일
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*credentials*.json
*service-account*.json
.npmrc
